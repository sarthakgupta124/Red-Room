# The Red Room - Environment Configuration

# =============================================================================
# LLM API Key (single provider)
# =============================================================================
# Set one of these. Gemini is the default when GEMINI_API_KEY is present.
# - Gemini: https://makersuite.google.com/app/apikey
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/

GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Local LLM Configuration (Optional)
# =============================================================================
# For local LLM using Ollama (https://ollama.ai/)
# OLLAMA_HOST=http://localhost:11434

# =============================================================================
# GitHub Integration (Optional)
# =============================================================================
# For automatic PR creation
# GITHUB_TOKEN=your_github_personal_access_token
# GITHUB_REPOSITORY=your-org/your-repo

# =============================================================================
# Redis Configuration (Optional)
# =============================================================================
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Database
# =============================================================================
# DATABASE_URL=sqlite:///./redroom_scans.db

# =============================================================================
# Logging Configuration
# =============================================================================
# LOG_LEVEL=INFO
# LOG_FORMAT=json
